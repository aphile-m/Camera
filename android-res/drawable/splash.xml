<?xml version="1.0" encoding="utf-8"?>
<!-- Replaces Capacitor's bitmap splash, which stretches to fill and cannot
     stay centred across aspect ratios. A layer-list keeps the mark true size. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/app_launch_background"/>
    <item android:gravity="center" android:drawable="@drawable/splash_mark"/>
</layer-list>
